# Copie para .env e preencha. Nunca versione o .env.
PORT=4100
HOST=127.0.0.1
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
RATE_LIMIT_PER_MINUTE=120

# IA (opcional). O sistema funciona sem ela, só por regras. Só liga com os TRÊS campos preenchidos.
# Qualquer provedor que aceite o formato "chat completions" da OpenAI. Exemplos de URL base (confirme na documentação de cada um):
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:          https://api.groq.com/openai/v1
#   OpenRouter:    https://openrouter.ai/api/v1
#   xAI (Grok):    https://api.x.ai/v1
#   SambaNova:     https://api.sambanova.ai/v1
# ATENÇÃO: planos gratuitos podem registrar o que você envia. Use só textos de teste, nunca dados reais de saúde.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Outros modelos do MESMO provedor, separados por vírgula: usados em ordem se o principal estiver sobrecarregado (429) ou indisponível.
LLM_FALLBACK_MODELS=
# Se o provedor rejeitar response_format (erro 400), use false.
LLM_JSON_MODE=true
# Para modelos que "pensam" (ex.: Gemini 2.5/3), use low ou none: resposta mais rápida e sem gastar tokens raciocinando.
LLM_REASONING_EFFORT=
# A IA escrever a frase de abertura das opções (true/false). Desligado: mais rápido e usa metade das chamadas.
LLM_EXPLAIN=false
LLM_TIMEOUT_MS=8000
LLM_MAX_PER_MINUTE=20

# Segundo provedor (opcional): usado se o primeiro falhar (sobrecarga, cota, pagamento exigido…). Teste com: npm run ai:check -- --second
LLM2_BASE_URL=
LLM2_API_KEY=
LLM2_MODEL=
LLM2_FALLBACK_MODELS=
